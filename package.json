{
  "name": "datum-gateway-startos",
  "scripts": {
    "build": "rm -rf ./javascript && ncc build startos/index.ts -o ./javascript",
    "prettier": "prettier --write startos",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@start9labs/start-sdk": "4.1.0",
    "bitcoin-knots-startos": "github:horizon-btc/knots-startos#master"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@vercel/ncc": "^0.38.4",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3"
  },
  "prettier": {
    "trailingComma": "all",
    "tabWidth": 2,
    "semi": false,
    "singleQuote": true
  },
  "overrides": {
    "@start9labs/start-sdk": "$@start9labs/start-sdk",
    "tor-startos": "github:Start9Labs/tor-startos#8a6ab4b0a5f2063d2eeb972a953d8701feb10749"
